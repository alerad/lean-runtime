{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-runtime.dev/schemas/check-batch-v1.schema.json",
  "type": "object",
  "required": ["schema", "ok", "data", "warnings", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "lean-runtime.check-batch/v1"},
    "ok": {"type": "boolean"},
    "data": {
      "type": "object",
      "anyOf": [{"required": ["ok", "duration_ms", "total", "accepted", "entries"]}, {"maxProperties": 0}],
      "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "result"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string"},
              "result": {"$ref": "https://lean-runtime.dev/schemas/execution-v1.schema.json#/$defs/execution"}
            }
          }
        }
      }
    },
    "warnings": {"$ref": "https://lean-runtime.dev/schemas/execution-v1.schema.json#/$defs/issues"},
    "errors": {"$ref": "https://lean-runtime.dev/schemas/execution-v1.schema.json#/$defs/issues"}
  }
}
