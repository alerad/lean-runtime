{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lean-runtime.dev/schemas/diff-v1.schema.json",
  "type": "object",
  "required": ["schema", "ok", "data", "warnings", "errors"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "lean-runtime.diff/v1"},
    "ok": {"type": "boolean"},
    "data": {
      "type": "object",
      "anyOf": [{"required": ["equal", "identity_equal", "summary", "left", "right", "changes"]}, {"maxProperties": 0}],
      "additionalProperties": false,
      "properties": {
        "equal": {"type": "boolean"},
        "identity_equal": {"type": "boolean"},
        "summary": {"type": "string"},
        "left": {"$ref": "#/$defs/subject"},
        "right": {"$ref": "#/$defs/subject"},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
      }
    },
    "warnings": {"$ref": "https://lean-runtime.dev/schemas/execution-v1.schema.json#/$defs/issues"},
    "errors": {"$ref": "https://lean-runtime.dev/schemas/execution-v1.schema.json#/$defs/issues"}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["kind", "lock_id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["lock", "environment"]},
        "lock_id": {"type": "string"},
        "environment_id": {"type": "string"}
      }
    },
    "change": {
      "type": "object",
      "required": ["path", "kind", "identity_effect", "before", "after"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "kind": {"enum": ["added", "changed", "removed"]},
        "identity_effect": {"type": "boolean"},
        "before": true,
        "after": true
      }
    }
  }
}
